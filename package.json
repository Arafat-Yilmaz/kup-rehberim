{
  "name": "kup-rehberim",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "ng build --base-href ./ && esbuild src/solver.worker.ts --bundle --format=iife --platform=browser --minify --outfile=dist/solver.worker.js && node scripts/build-pwa.mjs",
